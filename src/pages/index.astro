---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<h1>My Blog</h1>

<p><a href="/admin">Go to Admin Panel</a></p>

<ul>
  {posts.map(post => (
    <li>
      <a href={`${import.meta.env.BASE_URL}blog/${post.slug}/`}>
        {post.data.title}
      </a>
    </li>
  ))}
</ul>
